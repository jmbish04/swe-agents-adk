{
  "name": "mindhive",
  "private": true,
  "scripts": {
    "dev:fe": "pnpm -C src/frontend dev",
    "dev:be": "pnpm -C src/backend dev",
    "build:fe": "pnpm -C src/frontend build",
    "build:be": "pnpm -C src/backend build",
    "deploy:fe": "pnpm -C src/frontend deploy",
    "deploy:be": "pnpm -C src/backend deploy",
    "deploy": "pnpm build:fe && pnpm deploy:be",
    "types": "pnpm -C src/backend types",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate:local": "pnpm -C src/backend migrate:local",
    "migrate:remote": "pnpm -C src/backend migrate:remote",
    "fmt": "pnpm -C src/frontend fmt",
    "lint": "pnpm -C src/frontend lint"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "drizzle-kit": "^0.24.0"
  }
}
