{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "types": [
      "./worker-configuration.d.ts",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@agents/*": ["./ai/agents/*"],
      "@ai/*": ["./ai/*"],
      "@api/*": ["./api/*"],
      "@db/*": ["./db/*"],
      "@health/*": ["./health/*"],
      "@logging/*": ["./logging/*"],
      "@routes/*": ["./routes/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "worker-configuration.d.ts"]
}
