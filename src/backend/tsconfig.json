{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    // lib MUST be [ESNext] only — omitting "dom" prevents TypeScript's built-in DOM
    // types from conflicting with the Cloudflare Workers runtime types in worker-configuration.d.ts.
    // See: https://developers.cloudflare.com/workers/languages/typescript/
    "lib": ["ESNext"],
    "types": [
      "./worker-configuration.d.ts",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@agents/*": ["./agents/*"],
      "@ai/*": ["./ai/*"],
      "@api/*": ["./api/*"],
      "@db/*": ["./db/*"],
      "@health/*": ["./health/*"],
      "@logging/*": ["./logging/*"],
      "@routes/*": ["./routes/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "worker-configuration.d.ts"]
}
