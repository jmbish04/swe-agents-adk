---
/**
 * /project-viewport/[id]/chatroom/agent — Chat with individual agents
 *
 * Allows the user to open a direct conversation with specific agents
 * (e.g. Orchestrator, Product Manager, Cloudflare Team, GitHub Team, etc.)
 * Each agent chat is a separate WebSocket session backed by a Durable Object.
 */
import AppLayout from "@/layouts/AppLayout.astro";
import { projectViewportNav } from "@/components/SidebarNav";

const { id } = Astro.params;
const navSections = projectViewportNav(id!);

const agents = [
  { key: "orchestrator", label: "Orchestrator" },
  { key: "product-manager", label: "Product Manager" },
  { key: "ux-team", label: "UX Team" },
  { key: "python-team", label: "Python Team" },
  { key: "cloudflare-team", label: "Cloudflare Team" },
  { key: "github-team", label: "GitHub Team" },
  { key: "specialty", label: "Specialty Agent" },
];
---

<AppLayout
  title="Chat by Agent — MindHive"
  description="Open direct conversations with individual agents."
  navSections={navSections}
>
  <span slot="topbar">
    <nav class="flex items-center gap-1 text-sm text-muted-foreground">
      <a href="/applications" class="hover:text-foreground">Applications</a>
      <span>/</span>
      <span class="text-foreground font-medium">Project {id}</span>
      <span>/</span>
      <span class="text-foreground font-medium">Chatroom › By Agent</span>
    </nav>
  </span>

  <div class="flex h-[calc(100svh-8rem)] gap-4 overflow-hidden">
    <!-- Agent selector -->
    <aside class="w-48 shrink-0 overflow-y-auto rounded-xl border border-border/60 bg-card shadow-xs">
      <div class="p-3">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          Agents
        </p>
        <nav class="flex flex-col gap-1">
          {
            agents.map((agent) => (
              <a
                href={`?agent=${agent.key}`}
                class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                data-agent={agent.key}
              >
                {agent.label}
              </a>
            ))
          }
        </nav>
      </div>
    </aside>

    <!-- Chat window -->
    <div class="flex flex-1 flex-col overflow-hidden rounded-xl border border-border/60 bg-card shadow-xs">
      <div class="border-b border-border/60 px-4 py-3">
        <p class="text-sm font-medium">Select an agent to start chatting</p>
      </div>
      <!--
        TODO: Wire to @assistant-ui/react useAgentChat hook.
        Messages pane + input bar.
        WebSocket connects to /api/ws/agent/[agentKey]?projectId=[id]
      -->
      <div id="chat-messages" class="flex-1 overflow-y-auto p-4">
        <p class="text-sm text-muted-foreground">No messages yet.</p>
      </div>
      <div class="border-t border-border/60 p-3">
        <div class="flex gap-2">
          <input
            id="chat-input"
            type="text"
            placeholder="Message the agent…"
            class="flex-1 rounded-md border border-border bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring"
          />
          <button
            id="chat-send-btn"
            class="inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/80"
          >
            Send
          </button>
        </div>
      </div>
    </div>
  </div>
</AppLayout>
