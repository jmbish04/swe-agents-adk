---
/**
 * /project-viewport/[id]/backlog — Epic & user story backlog
 *
 * Hierarchical view: Epics → User Stories → Tasks.
 * Agents can create/update entries; user can also manage manually.
 */
import AppLayout from "@/layouts/AppLayout.astro";
import { projectViewportNav } from "@/components/SidebarNav";

const { id } = Astro.params;
const navSections = projectViewportNav(id!);
---

<AppLayout
  title="Backlog — MindHive"
  description="Epic and user story backlog for this project."
  navSections={navSections}
>
  <span slot="topbar">
    <nav class="flex items-center gap-1 text-sm text-muted-foreground">
      <a href="/applications" class="hover:text-foreground">Applications</a>
      <span>/</span>
      <span class="text-foreground font-medium">Project {id}</span>
      <span>/</span>
      <span class="text-foreground font-medium">Backlog</span>
    </nav>
  </span>

  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Backlog</h1>
        <p class="text-sm text-muted-foreground">Epics and user stories for this project.</p>
      </div>
      <div class="flex gap-2">
        <!-- TODO: Wire to CreateEpicModal and CreateStoryModal -->
        <button
          id="create-epic-btn"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-border px-4 text-sm font-medium transition-colors hover:bg-muted"
        >
          + Epic
        </button>
        <button
          id="create-story-btn"
          class="inline-flex h-9 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/80"
        >
          + User Story
        </button>
      </div>
    </div>

    <!--
      TODO: Render epic/story tree from API (projectId).
      Structure:
        Epic (expandable)
          └─ User Story (status badge: to-do / in-progress / done)
               └─ Tasks count chip
    -->
    <div class="rounded-xl border border-border/60 bg-card p-6 shadow-xs">
      <p class="text-sm text-muted-foreground">No epics yet.</p>
    </div>
  </div>
</AppLayout>
