---
/**
 * AppLayout — sidebar shell used by all authenticated app pages.
 *
 * Props:
 *   title       — page <title>
 *   description — meta description
 *   ogImage     — optional OG image URL
 *   navSections — pre-built NavSection[] from SidebarNav helpers
 */
import HeadSEO from "@/components/HeadSEO.astro";
import { SidebarNav } from "@/components/SidebarNav";
import { ThemeToggle } from "@/components/ThemeToggle";
import { cn } from "@/lib/utils";

const { title, description, ogImage, navSections } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <HeadSEO title={title} description={description} ogImage={ogImage} />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const dark = stored ? stored === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", dark);
        } catch {}
      })();
    </script>
  </head>
  <body class={cn("overscroll-none antialiased")}>
    <div class="bg-background flex min-h-svh">
      <!-- Sidebar -->
      <aside class="hidden w-60 shrink-0 border-r border-border/60 lg:flex lg:flex-col">
        <div class="flex h-14 items-center border-b border-border/60 px-4">
          <a href="/dashboard" class="flex items-center gap-2 text-sm font-semibold">
            <span class="text-foreground">MindHive</span>
          </a>
        </div>
        <div class="flex-1 overflow-y-auto">
          <SidebarNav
            sections={navSections}
            currentPath={currentPath}
            client:load
          />
        </div>
        <div class="flex h-14 items-center justify-end border-t border-border/60 px-4">
          <ThemeToggle client:load />
        </div>
      </aside>

      <!-- Main content -->
      <div class="flex flex-1 flex-col overflow-hidden">
        <!-- Top bar (mobile breadcrumb / actions slot) -->
        <header class="flex h-14 shrink-0 items-center gap-4 border-b border-border/60 px-4 lg:px-6">
          <slot name="topbar" />
        </header>
        <main class="flex flex-1 flex-col overflow-y-auto p-4 lg:p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
